<script>
(function(){
  var input=document.getElementById('ab-find');
  var hint=document.getElementById('ab-hint');
  var chips=Array.prototype.slice.call(document.querySelectorAll('#activity-board .ab-n'));
  var base=hint.innerHTML;
  function run(){
    var q=input.value.trim().toLowerCase();
    var found=[];
    chips.forEach(function(c){
      var on = q.length>1 && c.textContent.toLowerCase().indexOf(q)!==-1;
      c.classList.toggle('ab-hit',on);
      if(on){
        var shot=c.closest('.ab-shot');
        if(shot){ found.push('<b>'+shot.getAttribute('data-label')+'</b>'); return; }
        var card=c.closest('.ab-card'), slot=c.closest('.ab-slot'), day=c.closest('.ab-day');
        if(card&&slot&&day){
          var t=slot.querySelector('.ab-disc .ab-t').textContent;
          var ap=slot.querySelector('.ab-disc .ab-ap').textContent.toLowerCase();
          var d=day.querySelector('.ab-day-label').textContent.split(',')[0];
          found.push('<b>'+d+' '+t+ap+'</b> '+card.querySelector('h4').textContent);
        }
      }
    });
    if(q.length<2){ hint.innerHTML=base; return; }
    hint.innerHTML = found.length ? found.join(' &nbsp;·&nbsp; ') : 'No match for "'+input.value.trim()+'".';
  }
  input.addEventListener('input',run);
})();
</script>
</section>
